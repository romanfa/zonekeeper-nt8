@@ -0,0 +1,28 @@
+-- Reset polling and playback never consume the independent trade upload budget.
+ALTER TABLE api_usage ADD COLUMN reset_calls INTEGER NOT NULL DEFAULT 0;
+
+-- Durable opt-in requests. Entry existence alone never completes a request.
+CREATE TABLE automatic_resets (
+ user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+ trade_id INTEGER NOT NULL REFERENCES trades(id) ON DELETE CASCADE,
+ created_at INTEGER NOT NULL,
+ completed_at INTEGER,
+ attempt_id TEXT,
+ audio_id TEXT,
+ duration_seconds REAL,
+ started_at REAL,
+ progress_at REAL,
+ position_seconds REAL NOT NULL DEFAULT 0,
+ played_seconds REAL NOT NULL DEFAULT 0,
+ PRIMARY KEY(user_id, trade_id)
+);
+CREATE INDEX automatic_resets_pending ON automatic_resets(user_id, completed_at, trade_id);
+CREATE TABLE reset_handoffs (
+ token_hash TEXT PRIMARY KEY,
+ user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+ trade_id INTEGER NOT NULL REFERENCES trades(id) ON DELETE CASCADE,
+ device_id INTEGER NOT NULL REFERENCES devices(id) ON DELETE CASCADE,
+ expires_at INTEGER NOT NULL,
+ used_at INTEGER
+);
+CREATE INDEX reset_handoffs_expiry ON reset_handoffs(expires_at);
diff --git a/public/app/js/automatic-playback.js b/public/app/js/automatic-playback.js
new file mode 100644
index 0000000..baeb4b2
--- /dev/null
+++ b/public/app/js/automatic-playback.js
@@ -0,0 +1,78 @@
+// Browser-side playback proof. The server independently enforces elapsed time,
+// ownership, subscription, attempt identity and completion. No device credential.
+export class AutomaticPlayback {
+  constructor(post, now = () => performance.now()) {
+    this.post = post;
+    this.now = now;
+    this.closed = false;
+    this.invalid = false;
+    this.ready = false;
+    this.position = 0;
+    this.lastPosition = 0;
+    this.lastAt = now();
+    this.queue = Promise.resolve();
+  }
+
+  async start(tradeId, audioId) {
+    this.tradeId = tradeId;
+    const result = await this.post('/api/resets/start', { trade_id: tradeId, audio_id: audioId });
+    if (this.closed) return;
+    if (!result.attempt_id || !Number.isFinite(result.duration_seconds) || result.duration_seconds <= 0) throw new Error('Invalid audio start confirmation.');
+    this.attempt = result.attempt_id;
+    this.duration = result.duration_seconds;
+    this.lastAt = this.now();
+  }
+
+  observe(audio) {
+    if (this.closed) throw new Error('Reset was closed. Reopen it to listen again.');
+    if (this.invalid) throw new Error('Playback was interrupted. Restart this reset.');
+    if (!this.attempt) return;
+    const at = this.now();
+    const position = audio.currentTime;
+    const delta = position - this.lastPosition;
+    const elapsed = Math.max(0, (at - this.lastAt) / 1000);
+    if (!Number.isFinite(position) || position < 0 || audio.playbackRate !== 1
+      || (audio.seeking && position > 0.25) || delta < -0.25 || delta > elapsed * 1.1 + 0.75) {
+      this.invalid = true;
+      this.ready = false;
+      throw new Error('Playback changed or skipped. Restart this reset and listen from the beginning.');
+    }
+    this.position = Math.max(this.position, position);
+    this.lastPosition = position;
+    this.lastAt = at;
+  }
+
+  progress() {
+    if (this.closed || this.invalid || !this.attempt) return Promise.resolve();
+    const position = this.position;
+    const next = this.queue.catch(() => {}).then(() => {
+      if (this.closed || this.invalid) throw new Error('Reset was closed or playback interrupted.');
+      return this.post('/api/resets/progress', { trade_id: this.tradeId, attempt_id: this.attempt, position_seconds: position });
+    });
+    this.queue = next;
+    return next;
+  }
+
+  async ended(audio) {
+    this.observe(audio);
+    if (!audio.ended || !Number.isFinite(audio.duration) || audio.duration <= 0
+      || audio.currentTime < audio.duration - 0.5) throw new Error('The audio has not ended.');
+    const result = await this.progress();
+    if (this.closed) throw new Error('Reset was closed.');
+    if (!result?.ready) throw new Error('Audio playback was not confirmed. Restart this reset and listen again.');
+    this.ready = true;
+  }
+
+  async complete(entry) {
+    if (this.closed) throw new Error('Reset was closed.');
+    if (!this.ready || this.invalid) throw new Error('Listen to the full audio before completing this reset.');
+    if (!Number.isInteger(entry.tilt_after) || entry.tilt_after < 0 || entry.tilt_after > 10) throw new Error('Choose your final tilt first.');
+    const result = await this.post('/api/resets/complete', {
+      trade_id: this.tradeId, attempt_id: this.attempt, done: true, entry,
+    });
+    if (result?.status !== 'completed') throw new Error('The server did not confirm reset completion.');
+    return result;
+  }
+
+  cancel() { this.closed = true; this.ready = false; }
+}
