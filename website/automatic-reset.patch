+ }
+});
+test('unlinked manual logs remain counted with and without typed P/L', () => {
+ assert.equal(totals([log, { ...log, id: 3, pnl_cents: null }]).trades, 3);
+ assert.equal(totals([log, { ...log, id: 3, pnl_cents: null }]).pnlCents, -5000);
+});
