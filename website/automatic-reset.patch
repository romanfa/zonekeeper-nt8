diff --git a/scripts/automatic-playback.test.mjs b/scripts/automatic-playback.test.mjs
new file mode 100644
index 0000000..225e3e1
--- /dev/null
+++ b/scripts/automatic-playback.test.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { AutomaticPlayback } from '../public/app/js/automatic-playback.js';
+
+function fixture() {
+  let now = 0;
+  const calls = [];
+  const proof = new AutomaticPlayback(async (path, body) => {
+    calls.push({ path, body });
+    if (path.endsWith('/start')) return { attempt_id: 'attempt', duration_seconds: 10 };
+    if (path.endsWith('/progress')) return { played_seconds: body.position_seconds, ready: body.position_seconds >= 10 };
+    return { status: 'completed', entry: { id: 99, trade_id: 7 } };
+  }, () => now);
+  return { proof, calls, advance: (ms) => { now += ms; } };
+}
+const frame = (currentTime, extra = {}) => ({ currentTime, duration: 10, paused: false, ended: false, seeking: false, playbackRate: 1, ...extra });
+
+test('no completion before actual audio ended and explicit final tilt', async () => {
+  const { proof, calls } = fixture();
+  await proof.start(7, 'b1');
+  await assert.rejects(proof.complete({ tilt_after: 3 }), /audio/i);
+  assert.equal(calls.filter(c => c.path.endsWith('/complete')).length, 0);
+});
+
+test('sequential playback, final audio end and Done complete the bound trade once', async () => {
+  const { proof, calls, advance } = fixture();
+  await proof.start(7, 'b1');
+  for (let second = 1; second <= 10; second++) { advance(1000); proof.observe(frame(second)); }
+  await proof.ended(frame(10, { ended: true, paused: true }));
+  await assert.rejects(proof.complete({}), /tilt/i);
+  const result = await proof.complete({ tilt_after: 3 });
+  assert.equal(result.status, 'completed');
+  assert.equal(calls.at(-1).body.trade_id, 7);
+  assert.equal(calls.at(-1).body.attempt_id, 'attempt');
+  assert.equal(calls.at(-1).body.done, true);
+});
+
+test('seeking ahead or accelerated playback cannot satisfy the audio requirement', async () => {
+  for (const bad of [frame(10, { seeking: true }), frame(10), frame(1, { playbackRate: 2 })]) {
+    const { proof, advance } = fixture();
+    await proof.start(7, 'b1');
+    advance(1000);
+    assert.throws(() => proof.observe(bad), /playback/i);
+    await assert.rejects(proof.ended(frame(10, { ended: true })), /playback/i);
+  }
+});
+
+test('closing or network failure never completes a reset', async () => {
+  const { proof, calls } = fixture();
+  await proof.start(7, 'b1');
+  proof.cancel();
+  await assert.rejects(proof.complete({ tilt_after: 3 }), /closed/i);
+  assert.equal(calls.filter(c => c.path.endsWith('/complete')).length, 0);
+  const failed = new AutomaticPlayback(async () => { throw new Error('network'); });
+  await assert.rejects(failed.start(7, 'b1'), /network/);
+  await assert.rejects(failed.complete({ tilt_after: 3 }), /audio/);
+});
+
+test('a paused interval does not create extra progress or prevent normal resume', async () => {
+  const { proof, advance } = fixture();
+  await proof.start(7, 'b1');
+  advance(1000); proof.observe(frame(1));
+  advance(60000); proof.observe(frame(1, { paused: true }));
+  for (let second = 2; second <= 10; second++) { advance(1000); proof.observe(frame(second)); }
+  await proof.ended(frame(10, { ended: true, paused: true }));
+  assert.equal((await proof.complete({ tilt_after: 0 })).status, 'completed');
+});
+
+test('late start response after close cannot reactivate the attempt', async () => {
+  let resolve;
+  const proof = new AutomaticPlayback(() => new Promise(r => { resolve = r; }));
+  const start = proof.start(7, 'b1');
+  proof.cancel();
+  resolve({ attempt_id: 'late', duration_seconds: 10 });
+  await start;
+  await assert.rejects(proof.complete({ tilt_after: 3 }), /closed/);
+});
+
+test('server refusing final progress leaves reset incomplete and retryable', async () => {
+  let now = 0;
+  let available = false;
+  const proof = new AutomaticPlayback(async path => {
+    if (path.endsWith('/start')) return { attempt_id: 'a', duration_seconds: 10 };
+    if (path.endsWith('/progress')) { if (!available) throw new Error('offline'); return { ready: true }; }
+    return { status: 'completed' };
+  }, () => now);
+  await proof.start(7, 'b1');
+  for (let second = 1; second <= 10; second++) { now += 1000; proof.observe(frame(second)); }
+  await assert.rejects(proof.ended(frame(10, { ended: true })), /offline/);
+  await assert.rejects(proof.complete({ tilt_after: 3 }), /audio/);
+  available = true;
+  await proof.ended(frame(10, { ended: true }));
+  assert.equal((await proof.complete({ tilt_after: 3 })).status, 'completed');
+});
