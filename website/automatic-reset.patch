+      const played=Math.min(row.played_seconds+delta,stamp-row.started_at,row.duration_seconds);
+      await ctx.env.DB.prepare(`UPDATE automatic_resets SET progress_at=?,position_seconds=?,played_seconds=?
+        WHERE user_id=? AND trade_id=? AND attempt_id=? AND completed_at IS NULL AND progress_at=? AND position_seconds=?`)
+        .bind(stamp,pos,played,ctx.user.id,row.trade_id,row.attempt_id,row.progress_at,row.position_seconds).run();
+      const current=await attemptFor(ctx);
+      return json({played_seconds:current.played_seconds,duration_seconds:current.duration_seconds,ready:ready(current)});
+    },
+    async complete(ctx) {
+      const row=await attemptFor(ctx);
+      if(ctx.body.done!==true) throw bad('explicit Done is required');
+      if(row.completed_at!==null) return json({status:'completed',entry:await entryFor(ctx.env,ctx.user.id,row.trade_id)});
+      if(!ready(row)) throw bad('full playback is required');
+      const sent=ctx.body.entry;
+      if(!sent || !Number.isInteger(sent.tilt_after) || sent.tilt_after<0 || sent.tilt_after>10) throw bad('final tilt is required');
+      if(sent.audio_id!==row.audio_id) throw bad('audio_id differs from playback');
+      const existing=await entryFor(ctx.env,ctx.user.id,row.trade_id);
+      const prepared=await prepareEntry({...ctx,body:{...sent,kind:'after_trade',trade_id:row.trade_id,again:false,request_id:existing?.request_id||null},prepareReset:true});
+      if(prepared instanceof Response) return prepared;
+      const {insert,values,resetValues}=prepared;
+      // Resuming keeps trade identity/P&L; explicit grade edits behave like normal journal edits.
+      if (Object.hasOwn(sent, 'setup_grade')) resetValues.setup_grade = values[17];
+      if (Object.hasOwn(sent, 'rules_kept')) resetValues.rules_kept = values[18];
+      // Every mutation rechecks attempt identity within the same atomic D1 batch. A racing restart cannot finish an old attempt.
+      const eligible='EXISTS(SELECT 1 FROM automatic_resets r WHERE r.user_id=? AND r.trade_id=? AND r.attempt_id=? AND r.completed_at IS NULL AND r.played_seconds>=r.duration_seconds-2 AND r.position_seconds>=r.duration_seconds-2)';
+      const guard=[ctx.user.id,row.trade_id,row.attempt_id];
+      const insertSelect=insert.slice(0,insert.indexOf('VALUES'))+`SELECT ${values.map(()=>'?').join(',')} WHERE ${eligible} ON CONFLICT DO NOTHING`;
+      const fields=Object.keys(resetValues);
+      await ctx.env.DB.batch([
+        ctx.env.DB.prepare(insertSelect).bind(...values,...guard),
+        ctx.env.DB.prepare(`UPDATE entries SET ${fields.map(f=>'"'+f+'"=?').join(',')} WHERE user_id=? AND trade_id=? AND ${eligible}`)
+          .bind(...Object.values(resetValues),ctx.user.id,row.trade_id,...guard),
+        ctx.env.DB.prepare(`UPDATE automatic_resets SET completed_at=? WHERE user_id=? AND trade_id=? AND attempt_id=? AND completed_at IS NULL
+          AND EXISTS(SELECT 1 FROM entries e WHERE e.user_id=automatic_resets.user_id AND e.trade_id=automatic_resets.trade_id)`).bind(now(),...guard)
+      ]);
+      const final=await attemptFor(ctx);
+      if(final.completed_at===null) throw bad('completion changed; retry');
+      return json({status:'completed',entry:await entryFor(ctx.env,ctx.user.id,row.trade_id)});
+    }
+  };
+}
