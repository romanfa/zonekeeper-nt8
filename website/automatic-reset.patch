@@ -0,0 +1,107 @@
+// Authentication, paid access and same-origin enforcement live in the API/worker boundary.
+// Inject clock/crypto/entry validation so the actual SQL can be exercised in SQLite offline.
+export function automaticResets({ audios, now, token, hash, bad, prepareEntry }) {
+  const json = data => Response.json(data, {headers:{'Cache-Control':'no-store'}});
+  const id = value => { if (!Number.isSafeInteger(value) || value < 1) throw bad('trade_id'); return value; };
+  const entryFor = (env, uid, tid) => env.DB.prepare('SELECT * FROM entries WHERE user_id = ? AND trade_id = ?').bind(uid,tid).first();
+  const requestFor = async ({env,user,body}) => {
+    const row = await env.DB.prepare('SELECT * FROM automatic_resets WHERE user_id = ? AND trade_id = ?').bind(user.id,id(body.trade_id)).first();
+    if (!row) throw bad('reset not found');
+    return row;
+  };
+  const attemptFor = async ctx => {
+    const row = await requestFor(ctx);
+    if (!ctx.body.attempt_id || row.attempt_id !== ctx.body.attempt_id) throw bad('playback attempt expired');
+    return row;
+  };
+  const ready = row => row.position_seconds >= row.duration_seconds - 2 && row.played_seconds >= row.duration_seconds - 2;
+  return {
+    async enqueue({env,user}, tradeId) {
+      await env.DB.prepare(`INSERT INTO automatic_resets(user_id,trade_id,created_at)
+        SELECT user_id,id,? FROM trades WHERE user_id=? AND id=? ON CONFLICT(user_id,trade_id) DO NOTHING`).bind(now(),user.id,tradeId).run();
+    },
+    async pending({env,user,url}) {
+      const raw = url.searchParams.get('after') || '0';
+      if (!/^\d+$/.test(raw) || !Number.isSafeInteger(Number(raw))) throw bad('after');
+      const {results} = await env.DB.prepare(`SELECT t.id AS trade_id,t.instrument,t.pnl_cents,t.currency,t.exit_time
+        FROM automatic_resets r JOIN trades t ON t.id=r.trade_id AND t.user_id=r.user_id
+        WHERE r.user_id=? AND r.completed_at IS NULL AND r.trade_id>? ORDER BY r.trade_id LIMIT 101`).bind(user.id,Number(raw)).all();
+      return json({member_id:user.id,pending:results.slice(0,100),next_cursor:results.length>100?results[99].trade_id:0});
+    },
+    async deviceOpen(ctx) {
+      const row = await requestFor(ctx);
+      if (row.completed_at !== null) throw bad('reset already completed');
+      const handoff=token(), expires= Math.floor(now())+300;
+      await ctx.env.DB.batch([
+        ctx.env.DB.prepare('DELETE FROM reset_handoffs WHERE expires_at < ?').bind(now()-3600),
+        ctx.env.DB.prepare('INSERT INTO reset_handoffs(token_hash,user_id,trade_id,device_id,expires_at) VALUES(?,?,?,?,?)')
+          .bind(await hash(ctx.env,'reset:'+handoff),ctx.user.id,row.trade_id,ctx.device.id,expires)
+      ]);
+      return json({url:new URL('/app/#nt-reset='+encodeURIComponent(handoff),ctx.url.origin).href,expires_at:expires*1000});
+    },
+    async open({env,user,body}) {
+      if (typeof body.handoff !== 'string' || body.handoff.length>150) throw bad('handoff invalid');
+      // Member predicate is inside the consuming UPDATE: another member cannot burn the token.
+      const row=await env.DB.prepare(`UPDATE reset_handoffs SET used_at=? WHERE token_hash=? AND user_id=?
+        AND used_at IS NULL AND expires_at>? AND EXISTS(SELECT 1 FROM devices d WHERE d.id=reset_handoffs.device_id
+          AND d.user_id=reset_handoffs.user_id AND d.revoked_at IS NULL) RETURNING trade_id`)
+        .bind(now(),await hash(env,'reset:'+body.handoff),user.id,now()).first();
+      if (!row) throw bad('handoff invalid or expired');
+      const trade=await env.DB.prepare('SELECT * FROM trades WHERE user_id=? AND id=?').bind(user.id,row.trade_id).first();
+      const reset=await env.DB.prepare('SELECT completed_at FROM automatic_resets WHERE user_id=? AND trade_id=?').bind(user.id,row.trade_id).first();
+      return json({trade,entry:await entryFor(env,user.id,row.trade_id),status:reset?.completed_at!=null?'completed':'pending'});
+    },
+    async start(ctx) {
+      const row=await requestFor(ctx), audio=audios[ctx.body.audio_id];
+      if(row.completed_at!==null) throw bad('reset already completed');
+      if(!/^b\d*$/.test(ctx.body.audio_id||'') || !audio || !(audio.seconds>2)) throw bad('audio_id');
+      const attempt=token(), stamp=now();
+      await ctx.env.DB.prepare(`UPDATE automatic_resets SET attempt_id=?,audio_id=?,duration_seconds=?,started_at=?,progress_at=?,position_seconds=0,played_seconds=0
+        WHERE user_id=? AND trade_id=? AND completed_at IS NULL`).bind(attempt,ctx.body.audio_id,audio.seconds,stamp,stamp,ctx.user.id,row.trade_id).run();
+      return json({attempt_id:attempt,duration_seconds:audio.seconds});
+    },
+    async progress(ctx) {
+      const row=await attemptFor(ctx), pos=ctx.body.position_seconds, stamp=now();
+      if(typeof pos!=='number'||!Number.isFinite(pos)||pos<row.position_seconds||pos>row.duration_seconds+2) throw bad('playback position');
