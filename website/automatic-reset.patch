+const log = { id: 2, ts: 1, kind: 'after_trade', trigger: 'stop_loss', again: 0, local_date: date, local_hour: 12, pnl_cents: -2500 };
+const totals = (entries, trades = [trade], summaries = []) => dayTotals(dayMap(entries, [], summaries, [], trades).get(date));
